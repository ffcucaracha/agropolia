AGROPOLIA_ENV=development
AGROPOLIA_DATABASE_URL=postgresql+asyncpg://agropolia:agropolia@postgres:5432/agropolia
AGROPOLIA_REDIS_URL=redis://redis:6379/0
AGROPOLIA_NATS_URL=nats://nats:4222
AGROPOLIA_JWT_SECRET=change-me-in-local-env
AGROPOLIA_OTP_SECRET=change-me-in-local-env-too
AGROPOLIA_DEV_OTP_CODE=000000
AGROPOLIA_AUTH_EMAIL_ENABLED=true
AGROPOLIA_AUTH_PHONE_ENABLED=false
AGROPOLIA_EMAIL_DELIVERY_MODE=dev
AGROPOLIA_OTP_TTL_SECONDS=300
AGROPOLIA_OTP_RESEND_COOLDOWN_SECONDS=60
AGROPOLIA_SMTP_HOST=
AGROPOLIA_SMTP_PORT=587
AGROPOLIA_SMTP_USERNAME=
AGROPOLIA_SMTP_PASSWORD=
AGROPOLIA_SMTP_FROM_EMAIL=no-reply@agropolia.local
AGROPOLIA_SMTP_FROM_NAME=Агрополия
AGROPOLIA_SMTP_STARTTLS=true
AGROPOLIA_SMTP_SSL=false
AGROPOLIA_WEB_ORIGIN=http://localhost:5173
AGROPOLIA_COOKIE_SECURE=false
AGROPOLIA_ANDROID_LATEST_VERSION=0.1.0
AGROPOLIA_ANDROID_RECOMMENDED_VERSION=0.1.0
AGROPOLIA_ANDROID_MINIMUM_SUPPORTED_VERSION=0.1.0
AGROPOLIA_IOS_LATEST_VERSION=0.1.0
AGROPOLIA_IOS_RECOMMENDED_VERSION=0.1.0
AGROPOLIA_IOS_MINIMUM_SUPPORTED_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:8000/api/v1
